# ComfyUI — leave COMFY_BASE_URL blank to use Comfy Cloud
COMFY_API_KEY=
COMFY_BASE_URL=

# LLM used to expand the one-sentence logline into a shot list.
# Any OpenAI-compatible Chat Completions endpoint; defaults to Groq.
# Key: LLM_API_KEY, or GROQ_API_KEY if LLM_API_KEY is blank.
GROQ_API_KEY=
LLM_API_KEY=
# Blank = https://api.groq.com/openai/v1
LLM_BASE_URL=
# Blank = openai/gpt-oss-120b
LLM_MODEL=
# Tried if the primary model errors, times out (~20s) or returns bad JSON twice.
# Blank = qwen/qwen3.8-27b, "none" = no fallback model. If both fail, the mock answers.
LLM_FALLBACK_MODEL=
# 1 = always use the deterministic mock shot list (also used automatically when no key is set)
LLM_MOCK=

# Vercel Blob storage for rendered clips + published trailers.
# Blank = local disk (public/renders/, public/trailers/), fine for local dev.
BLOB_READ_WRITE_TOKEN=

# Public site origin for share links and og:video/og:image (blank = request host)
NEXT_PUBLIC_SITE_URL=

# Cost guard (checked before any Comfy call). Counts shots per UTC day.
# Per IP:
DAILY_RENDER_LIMIT=20
# Whole site:
GLOBAL_DAILY_SHOTS=300
# Shared counters across instances, first match wins:
# Neon Postgres connection string (needs the `usage` table from db/schema.sql; IPs stored hashed).
DATABASE_URL=
# Upstash Redis. If both are blank: in-memory (per process, resets on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 1 = play pre-rendered sample clips (public/samples/) instead of calling Comfy
DEMO_MODE=
