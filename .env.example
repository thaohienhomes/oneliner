# ComfyUI — leave COMFY_BASE_URL blank to use Comfy Cloud
COMFY_API_KEY=
COMFY_BASE_URL=

# LLM used to expand the one-sentence logline into a shot list.
# Any OpenAI-compatible Chat Completions endpoint (OpenAI, or Qwen/Llama on an
# OpenAI-compatible host). LLM_BASE_URL blank = https://api.openai.com/v1.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 1 = use the deterministic mock shot list (also used automatically when LLM_API_KEY is empty)
LLM_MOCK=

# Vercel Blob storage for rendered clips + published trailers.
# Blank = local disk (public/renders/, public/trailers/), fine for local dev.
BLOB_READ_WRITE_TOKEN=

# Public site origin for share links and og:video/og:image (blank = request host)
NEXT_PUBLIC_SITE_URL=

# Cost guard (checked before any Comfy call). Counts shots per UTC day.
# Per IP:
DAILY_RENDER_LIMIT=20
# Whole site:
GLOBAL_DAILY_SHOTS=300
# Shared counters across instances. Blank = in-memory (per process, resets on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 1 = play pre-rendered sample clips (public/samples/) instead of calling Comfy
DEMO_MODE=
